# Copy to deploy/sam2/service.env on the GPU host. Do not commit service.env.
SAM21_DEPLOY_ROOT=/share_data/zhangyurui/sam21_propagation
SAM21_ALLOWED_ROOT=/share_data/zhangyurui
SAM21_HOST=127.0.0.1
SAM21_PORT=5001
SAM21_DEVICE=cuda

# Optional overrides. Defaults are derived from SAM21_DEPLOY_ROOT.
# SAM21_ENV_DIR=/share_data/zhangyurui/sam21_propagation/env
# SAM21_SAM2_SOURCE_DIR=/share_data/zhangyurui/sam21_propagation/vendor/sam2
# SAM21_CHECKPOINT=/share_data/zhangyurui/sam21_propagation/checkpoints/sam2.1_hiera_tiny.pt
# SAM21_APP_PATH=/path/to/bunding-box-differ-test/sam2_service/app.py
